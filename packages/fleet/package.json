{
	"name": "@roo-code/fleet",
	"description": "OmniRoute fleet topology toolkit: inventory parser/printer/validator, route compiler, reconciler, observer, evaluator, and the fleetctl CLI.",
	"version": "0.0.1",
	"type": "module",
	"exports": "./src/index.ts",
	"bin": {
		"fleetctl": "./dist/cli/index.js"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"lint": "eslint src --ext=ts --max-warnings=0",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"clean": "rimraf .turbo"
	},
	"dependencies": {
		"@roo-code/types": "workspace:^",
		"better-sqlite3": "13.0.3",
		"commander": "^12.1.0",
		"kdljs": "0.3.0"
	},
	"devDependencies": {
		"@roo-code/config-eslint": "workspace:^",
		"@roo-code/config-typescript": "workspace:^",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "22.20.1",
		"fast-check": "3.23.2",
		"vitest": "4.1.11"
	}
}
